#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Read-only commands that need no state dir and no lock.
case "${1:-}" in
  contract|policy-check)
    exec node "${REPO_DIR}/src/cli/main.ts" "$@"
    ;;
esac

if [ -z "${EDGEKIT_STATE_DIR:-}" ]; then
  echo "EDGEKIT_STATE_DIR is required" >&2
  exit 1
fi

mkdir -p "${EDGEKIT_STATE_DIR}"
LOCKFILE="${EDGEKIT_STATE_DIR}/edgectl.lock"

exec flock -x "${LOCKFILE}" node "${REPO_DIR}/src/cli/main.ts" "$@"
